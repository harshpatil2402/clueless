{
  "name": "crossword",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @crossword/server\" \"npm run dev -w @crossword/web\"",
    "build": "npm run build -w @crossword/web",
    "start": "npm run start -w @crossword/server",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
